{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "FontForge",
  "description": "Create and edit outline and bitmap fonts.",
  "version": "20230101",
  "image": "ghcr.io/containerpak/fontforge@sha256:817278bea3d7ae6d9fab5e15bc465f37e73ccfdb8741b487775beeeaaa9fddd7",
  "binaries": [
    "/usr/bin/fontforge",
    "/usr/bin/fontimage",
    "/usr/bin/fontlint",
    "/usr/bin/sfddiff"
  ],
  "desktop_entries": [
    "/usr/share/applications/org.fontforge.FontForge.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": true,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [
      "GDK_BACKEND=x11"
    ],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
